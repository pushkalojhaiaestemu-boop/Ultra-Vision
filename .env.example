# Copy to .env and fill in to run against live providers.
# Leaving USE_MOCK_MODE=true (or leaving keys blank) runs the simulated corpus.

USE_MOCK_MODE=true

VISION_API_KEY=
LLM_API_KEY=
SEARCH_API_KEY=

ANTHROPIC_BASE_URL=https://api.anthropic.com
VISION_MODEL=claude-sonnet-4-5
LLM_MODEL=claude-sonnet-4-5
SEARCH_ENDPOINT=https://api.tavily.com/search

# Research budget. These are the only thing standing between the agent and
# an unbounded search bill, so keep them low while developing.
MAX_RESEARCH_ITERATIONS=5
MAX_SEARCHES=20
MAX_SOURCES=50
MAX_SOURCES_PER_QUERY=4
SEARCH_CACHE_SECONDS=3600

DATABASE_PATH=./data/research.sqlite3
